# Copy to .env and fill in.
ADMIN_PASSWORD=change-me
# Random string used to sign the admin session cookie: openssl rand -hex 32
SECRET_KEY=
# Public address players use (shown in instructions and baked into submit.sh)
PUBLIC_URL=http://localhost:8000
# Interface the app port binds to. 127.0.0.1 = only via caddy/ssh tunnel, 0.0.0.0 = open to everyone.
BIND=127.0.0.1
# Only needed with the https profile
DOMAIN=
# Parallel docker builds
BUILD_WORKERS=2
